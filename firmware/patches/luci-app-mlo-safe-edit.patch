Subject: [PATCH] luci-app-mlo: preserve APs and edit MLDs by section identity

Layer after luci-app-mlo-shared-iface.patch. Validate EHT and secure MLO
settings before changing UCI; never select standalone APs by SSID.

--- a/htdocs/luci-static/resources/view/mlo/main.js
+++ b/htdocs/luci-static/resources/view/mlo/main.js
@@ -63,6 +63,31 @@
 	return section.device ? [ section.device ] : [];
 }
 
+function isMloAp(section) {
+	return (!section.mode || section.mode === 'ap') &&
+		(section.mlo === '1' || section.mlo === 1 || section.mlo === true);
+}
+
+function ehtRadio(device) {
+	return /^EHT(20|40|80|160|320)$/.test(uci.get('wireless', device, 'htmode') || '');
+}
+
+function validateMld(rec) {
+	if (!rec.ssid || !rec.ssid.trim() || new TextEncoder().encode(rec.ssid).length > 32)
+		return _('SSID must contain 1–32 bytes.');
+	if (!rec.bands || rec.bands.size < 2)
+		return _('MLO requires at least 2 linked bands.');
+	const radios = radiosByBand();
+	if (Array.from(rec.bands).some(band => !radios[band] || !ehtRadio(radios[band])))
+		return _('Every linked band must use BE (Wi-Fi 7) mode. Configure the radios under Network → Wireless first; leave legacy 2.4 GHz outside MLO.');
+	if (rec.encryption !== 'sae' && rec.encryption !== 'owe')
+		return _('MLO requires WPA3-SAE or OWE with required protected management frames. WPA2, mixed mode, and unencrypted open networks are not supported here.');
+	const bytes = new TextEncoder().encode(rec.key || '').length;
+	if (rec.encryption === 'sae' && (bytes < 8 || bytes > 63 || /[\r\n\0]/.test(rec.key)))
+		return _('The WPA3 passphrase must contain 8–63 bytes without line breaks.');
+	return null;
+}
