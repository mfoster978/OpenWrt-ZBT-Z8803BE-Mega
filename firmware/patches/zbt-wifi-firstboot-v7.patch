--- a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/72-zbt-z8803be-wifi
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/72-zbt-z8803be-wifi
@@ -10,9 +10,15 @@
 	;;
 esac
 
-# Ensure /etc/config/wireless is populated (first boot races us sometimes).
+# No PHY means a driver/probe failure, not a successfully configured radio.
