#!/bin/sh
# Read-only routing evidence. No SSID keys, SIM identities, APNs or credentials.
. /usr/lib/zbt/mwan-runtime.sh
printf 'Configured priority: SFP -> WAN -> USB tether -> Modem 1 -> Modem 2\n'
printf 'Fresh tracked IPv4 winner: %s\n' "$(zbt_mwan_winner || echo none)"
printf 'Fresh tracked IPv6 winner: %s\n' "$(zbt_mwan_winner 6 || echo none)"
printf '\nInstalled policies (authoritative for forwarded LAN traffic):\n'
mwan3 status
printf '\nWi-Fi network memberships (no credentials):\n'
for section in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	printf '%s mode=%s network=%s disabled=%s\n' "$section" "$(uci -q get "wireless.$section.mode")" "$(uci -q get "wireless.$section.network")" "$(uci -q get "wireless.$section.disabled")"
done
printf '\nRouting rules: origin is managed only for default_rule/default_rule6; other rules are preserved, origin unverified.\n'
for section in $(uci -q show mwan3 | sed -n 's/^mwan3\.\([^.=]*\)=rule$/\1/p'); do
	printf '%s policy=%s family=%s source=%s source_ip=%s enabled=%s\n' "$section" "$(uci -q get "mwan3.$section.use_policy")" "$(uci -q get "mwan3.$section.family")" "$(uci -q get "mwan3.$section.src_iface")" "$(uci -q get "mwan3.$section.src_ip")" "$(uci -q get "mwan3.$section.enabled")"
done
printf '\nDirect modem health: uptime device ifindex overall IPv4 IPv6\n'
for slot in 4_1 2_1; do
	printf '%s: ' "$slot"; cat "/tmp/zbt-modem-health/$slot" 2>/dev/null || echo unknown
	printf 'mwan_enabled=%s proto=%s modem_owner=%s\n' "$(uci -q get "mwan3.$slot.enabled")" "$(uci -q get "network.$slot.proto")" "$(uci -q get "network.$slot.modem_config")"
	ubus call "network.interface.$slot" status 2>/dev/null | jq '{up,pending,available,autostart,proto,device,l3_device,"ipv4-address","ipv6-address"}'
done
printf '\nWatchdog and dial workers (running state and PID):\n'
for service in modem_watchdog qmodem_network; do
	ubus -t 5 call service list "{\"name\":\"$service\"}" 2>/dev/null |
		jq --arg service "$service" '{service:$service, instances:((.[$service].instances // {}) | with_entries(.value |= {running,pid,exit_code}))}'
done
printf '\nRecovery counters: failures successes last_attempt redials window_start attempts_in_window rx_errors ifindex\n'
for slot in 4_1 2_1; do
	printf '%s: ' "$slot"; cat "/tmp/modem-watchdog/$slot.state" 2>/dev/null || echo unknown
done
printf '\nModem GPIO power (saved switch value / current hardware value; read-only):\n'
for power in 5g1 5g2; do
	printf '%s saved=%s current=%s\n' "$power" "$(uci -q get "system.$power.value")" "$(cat "/sys/class/gpio/$power/value" 2>/dev/null || echo unknown)"
done
printf '\nIPv4 rules:\n'; ip -4 rule show
printf '\nIPv6 rules:\n'; ip -6 rule show
printf '\nRecent modem lifecycle, failback and recovery events:\n'
logread | grep -E 'zbt-mwan-failback|zbt-mwan-reconcile|modem-watchdog|zbt-qmi-session|qmodem_network' | tail -60
