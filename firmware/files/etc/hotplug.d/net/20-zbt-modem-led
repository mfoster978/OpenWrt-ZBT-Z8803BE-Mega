#!/bin/sh
# Netdev appearance is not Internet reachability. Never light an unprobed link.
case "$ACTION" in add|remove) ;; *) exit 0 ;; esac
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand) ;;
	*) exit 0 ;;
esac
/usr/sbin/zbt-modem-led-poller once >/dev/null 2>&1
