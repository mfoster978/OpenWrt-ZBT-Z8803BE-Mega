#!/bin/sh
set -eu

uci -q get speedify_bootstrap.main >/dev/null 2>&1 || uci -q set speedify_bootstrap.main='installer'
if ! uci -q get speedify_bootstrap.main.enabled >/dev/null 2>&1; then
	# Speedify is optional. Kept-config upgrades without an explicit choice
	# remain disabled rather than unexpectedly starting a VPN tunnel.
	uci -q set speedify_bootstrap.main.enabled='0'
fi
if ! uci -q get speedify_bootstrap.main.install_luci >/dev/null 2>&1; then
	# This image bakes the matching nginx/Python dependencies. Set to 0 before
	# installation to skip the proprietary Speedify UI and install core only.
	uci -q set speedify_bootstrap.main.install_luci='1'
fi
uci -q commit speedify_bootstrap


# A sysupgrade removes the runtime-installed vendor UI. Clear any preserved
# menu cache so the ROM-resident setup screen is immediately visible while the
# official APK is downloaded again.
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.json

# Synchronize rc.d state without starting the installer while first-boot
# network and firewall defaults are still being applied.
/usr/sbin/zbt-speedify-control sync >/dev/null 2>&1 || true
exit 0
