#!/bin/sh
# New default applies once to kept configurations; later user choices survive.
[ "$(uci -q get modem_watchdog.global.recovery_v1)" = 1 ] || {
	uci set modem_watchdog.global.enabled=1
	uci set modem_watchdog.global.actions_enabled=1
	uci set modem_watchdog.global.interval_seconds=30
	uci set modem_watchdog.global.ping_fail_threshold=4
	uci set modem_watchdog.global.cooldown_seconds=180
	uci set modem_watchdog.global.boot_grace_seconds=120
	uci set modem_watchdog.global.ping6_target=2606:4700:4700::1111
	for key in modem1 modem2; do
		uci set "modem_watchdog.$key.enabled=1"
		uci set "modem_watchdog.$key.action=power_cycle"
		uci set "modem_watchdog.$key.redial_attempts=0"
	done
	uci set modem_watchdog.global.recovery_v1=1
	uci commit modem_watchdog
}
# Separate QModem monitor stays off: central watchdog owns automatic resets.
for section in 4_1 2_1; do
	uci -q get "qmodem.$section" >/dev/null || continue
	uci set "qmodem.$section.monitor_enabled=0"
done
uci commit qmodem
# Retire only QModem-generated netdev LED rules; preserve custom LED rules.
for section in $(uci -q show system | sed -n 's/^system\.\([^.=]*\)=led$/\1/p'); do
	case "$(uci -q get "system.$section.sysfs"):$(uci -q get "system.$section.name")" in
		blue:mobile-1:4-1_net_indicator|blue:mobile-1:4_1_net_indicator|blue:mobile-2:2-1_net_indicator|blue:mobile-2:2_1_net_indicator)
			[ "$(uci -q get "system.$section.trigger")" != netdev ] || uci -q delete "system.$section" ;;
	esac
done
uci commit system
/etc/init.d/modem_watchdog enable
exit 0
