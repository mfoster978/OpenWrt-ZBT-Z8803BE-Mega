#!/bin/sh
# QModem's Network Configuration view saved UCI changes and then reloaded the
# dial service itself. Replace that override with an explicit promise chain:
# save the form, wait for LuCI to finish applying the staged UCI transaction,
# and reload QModem only after a successful apply. A rejected apply must never
# restart the modem service with partially applied settings.
set -eu
file=/www/luci-static/resources/view/qmodem/network_config.js
[ -f "$file" ] || exit 0

if grep -Fq "return ui.changes.apply(mode == '0');" "$file" &&
   grep -Fq "return callInitAction('qmodem_network', 'reload');" "$file"; then
	exit 0
fi

count=$(grep -Fc "handleSaveApply: function(ev, mode)" "$file" || true)
[ "$count" = 1 ] || {
	logger -t zbt-qmodem-ui "network Save & Apply patch skipped: expected one pinned handler, found $count"
	exit 1
}

tmp="$file.zbt.$$"
awk '
	BEGIN { replacing=0 }
	/^[[:space:]]*handleSaveApply: function\(ev, mode\) \{/ {
		print "\thandleSaveApply: function(ev, mode) {"
		print "\t\treturn this.handleSave(ev).then(function() {"
		print "\t\t\treturn ui.changes.apply(mode == '\''0'\'');"
		print "\t\t}).then(function() {"
		print "\t\t\treturn callInitAction('\''qmodem_network'\'', '\''reload'\'');"
		print "\t\t});"
		print "\t},"
		replacing=1
		next
	}
	replacing {
		if ($0 ~ /^[[:space:]]*},[[:space:]]*$/) replacing=0
		next
	}
	{ print }
' "$file" > "$tmp"

[ "$(grep -Fc "return ui.changes.apply(mode == '0');" "$tmp" || true)" = 1 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch failed apply-promise validation'
	exit 1
}
[ "$(grep -Fc "return callInitAction('qmodem_network', 'reload');" "$tmp" || true)" = 1 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch failed reload validation'
	exit 1
}
[ "$(grep -Fc "this.super('handleSaveApply', arguments)" "$tmp" || true)" = 0 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch retained non-awaiting base handler'
	exit 1
}

mv -f "$tmp" "$file"
logger -t zbt-qmodem-ui 'network Save & Apply now reloads QModem only after successful LuCI apply'
exit 0
