#!/bin/sh
# QModem's Network Configuration view saved UCI changes and then reloaded the
# dial service itself. Use LuCI's normal apply lifecycle instead. In the pinned
# LuCI version changes.apply() returns no completion Promise; chaining a reload
# would run before commit, including on Cancel or failure. QModem already has a
# procd qmodem config-change trigger, so the view must not reload it separately.
set -eu
file=/www/luci-static/resources/view/qmodem/network_config.js
[ -f "$file" ] || exit 0

if grep -Fq '// zbt-network-apply: config-change-trigger' "$file" &&
   grep -Fq "return ui.changes.apply(mode == '0');" "$file" &&
   ! grep -Fq "return callInitAction('qmodem_network', 'reload');" "$file"; then
	exit 0
fi

count=$(grep -Fc "handleSaveApply: function(ev, mode)" "$file" || true)
[ "$count" = 1 ] || {
	logger -t zbt-qmodem-ui "network Save & Apply patch skipped: expected one pinned handler, found $count"
	exit 1
}

tmp="$file.zbt.$$"
awk '
	BEGIN { replacing=0 }
	/^[[:space:]]*handleSaveApply: function\(ev, mode\) \{/ {
		print "\thandleSaveApply: function(ev, mode) {"
		print "\t\t// zbt-network-apply: config-change-trigger"
		print "\t\treturn this.handleSave(ev).then(function() {"
		print "\t\t\treturn ui.changes.apply(mode == '\''0'\'');"
		print "\t\t});"
		print "\t},"
		replacing=1
		next
	}
	replacing {
		if ($0 ~ /^[[:space:]]*},[[:space:]]*$/) replacing=0
		next
	}
	{ print }
' "$file" > "$tmp"

[ "$(grep -Fc "return ui.changes.apply(mode == '0');" "$tmp" || true)" = 1 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch failed apply validation'
	exit 1
}
[ "$(grep -Fc "return callInitAction('qmodem_network', 'reload');" "$tmp" || true)" = 0 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch failed reload validation'
	exit 1
}
[ "$(grep -Fc "this.super('handleSaveApply', arguments)" "$tmp" || true)" = 0 ] || {
	rm -f "$tmp"
	logger -t zbt-qmodem-ui 'network Save & Apply patch retained non-awaiting base handler'
	exit 1
}

mv -f "$tmp" "$file"
logger -t zbt-qmodem-ui 'network Save & Apply uses LuCI apply and the QModem config-change trigger'
exit 0
