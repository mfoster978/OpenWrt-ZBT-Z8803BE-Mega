#!/bin/sh /etc/rc.common
# Non-blocking Wi-Fi bring-up and health recovery.  The worker remains active
# after uci-defaults have been consumed so kept-configuration upgrades still
# recover when the MT7996 PHY appears after netifd's initial wireless pass.
START=95
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/zbt-wifi-firstboot
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 5
	procd_close_instance
}
