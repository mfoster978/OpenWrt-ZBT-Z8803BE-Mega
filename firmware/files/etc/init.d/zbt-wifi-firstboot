#!/bin/sh /etc/rc.common
# Non-blocking retry for defaults deferred because PHYs were not ready.
START=95
USE_PROCD=1
start_service() {
	[ -f /etc/uci-defaults/72-zbt-z8803be-wifi ] ||
		[ -f /etc/uci-defaults/73-zbt-us-wifi-defaults ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/zbt-wifi-firstboot
	procd_set_param term_timeout 5
	procd_close_instance
}
