#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=10

start_service() {
	[ "$(uci -q get zbt_adguard.main.enabled)" = 1 ] || {
		/usr/sbin/zbt-adguard dns-restore
		return 0
	}
	/usr/sbin/zbt-adguard verify || {
		/usr/sbin/zbt-adguard dns-restore
		return 1
	}
	/usr/sbin/zbt-adguard dns-takeover || return 1
	procd_open_instance server
	procd_set_param command /mnt/mega-apps/adguardhome/current/AdGuardHome \
		--config /mnt/mega-apps/adguardhome/config/AdGuardHome.yaml \
		--work-dir /mnt/mega-apps/adguardhome/work \
		--web-addr 0.0.0.0:3000 --no-check-update
	procd_set_param env HOME=/mnt/mega-apps/adguardhome/work TMPDIR=/mnt/mega-apps/adguardhome/work/tmp
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	/usr/sbin/zbt-adguard dns-restore
}

service_triggers() {
	procd_add_reload_trigger zbt_adguard zbt_apps fstab
}
