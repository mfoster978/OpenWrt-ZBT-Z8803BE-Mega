#!/bin/sh /etc/rc.common
# QModem service integration: one complete procd transaction at startup;
# targeted add/delete for user commands. Never nest rc_procd calls.
START=99
STOP=13
USE_PROCD=1
. /usr/lib/zbt/dual-modem.sh
extra_command "dial" "Start one modem"
extra_command "hang" "Stop one modem"
extra_command "redial" "Restart one modem"
extra_command "modem_status" "Show one modem"

armed() {
	case "$1" in 4_1|2_1) ;; *) return 1 ;; esac
	[ "$(uci -q get qmodem.main.enable_dial)" = 1 ] || return 1
	[ "$(uci -q get "qmodem.$1.enable_dial")" = 1 ] || return 1
	# state is QModem discovery state, not the operator's enable switch. A late
	# USB scan/remove-add race must not delete this persistent readiness worker.
	# It still cannot dial until qmodem-start verifies this slot's exact USB,
	# netdev and AT port; enable_dial remains the administrative authority.
	return 0
}
add_modem() {
	# Register the enabled slot even when its USB netdev/AT port is late. The
	# per-slot worker waits for its own exact hardware and then execs the dialer.
	armed "$1" || return 0
	procd_open_instance "modem_$1"
	procd_set_param command /usr/lib/zbt/qmodem-start.sh "$1"
	procd_set_param env "ZBT_DIAL_CONFIG=$(zbt_dial_fingerprint "$1")"
	# SIM reinsertion can follow a long outage. Keep a delayed retry alive;
	# do not permanently abandon the slot after ten short failed attempts.
	procd_set_param respawn 120 15 0
	procd_set_param term_timeout 15
	procd_close_instance
}
start_service() {
	mkdir -p /var/run/qmodem
	add_modem 4_1
	add_modem 2_1
}
reload_service() {
	# procd preserves unchanged peer instances; no blanket stop/hang.
	start
}
dial() {
	armed "$1" || return 1
	rc_procd add_modem "$1"
}
hang() {
	case "$1" in 4_1|2_1) ;; *) return 1 ;; esac
	procd_kill qmodem_network "modem_$1"
}
redial() {
	# Service deletion is asynchronous. Wait for this instance's old parent
	# to finish its child/address cleanup before starting a replacement.
	local old_pid attempts=0
	case "$1" in 4_1|2_1) ;; *) return 1 ;; esac
	old_pid=$(ubus -t 5 call service list '{"name":"qmodem_network"}' |
		jq -r --arg name "modem_$1" '.qmodem_network.instances[$name].pid // empty')
	case "$old_pid" in ''|*[!0-9]*|0|1) old_pid='' ;; esac
	hang "$1" >/dev/null 2>&1 || true
	while [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; do
		if [ "$attempts" -ge 20 ]; then
			logger -t qmodem_network "Refusing overlapping redial of $1: previous instance still stopping"
			return 1
		fi
		sleep 1
		attempts=$((attempts + 1))
	done
	dial "$1"
}
modem_status() {
	local status
	status=$(ubus call service list '{"name":"qmodem_network"}' |
		jq -ec --arg name "modem_$1" '.qmodem_network.instances[$name] | select(.running == true)')
	# QModem's RPC wrapper expects this marker, not an empty JSON object.
	if [ -n "$status" ]; then printf '%s\n' "$status"; else echo "modem_$1 Not Running"; fi
}
service_triggers() { procd_add_reload_trigger qmodem; }
