#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/zbt-lan-ipv6-guard loop
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	/usr/sbin/zbt-lan-ipv6-guard once >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger qmodem
	procd_add_reload_trigger network
	procd_add_reload_trigger mwan3
}
