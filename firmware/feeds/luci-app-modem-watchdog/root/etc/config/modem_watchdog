config modem_watchdog 'global'
	option routing_preset 'priority'
	option enabled '1'
	option actions_enabled '1'
	option interval_seconds '30'
	option cooldown_seconds '180'
	option ping_target '1.1.1.1'
	option ping6_target '2606:4700:4700::1111'
	option boot_grace_seconds '120'
	option ping_fail_threshold '4'
	option speed_test '0'
	option speed_test_cooldown_minutes '15'
	option speed_test_min_mbps '5'
	option speed_fail_threshold '2'
	option failover '0'
	option prefer_fastest '0'
	option fastest_delta_mbps '5'
	option log_level 'info'
config modem 'modem1'
	option section '4_1'
	option enabled '1'
	option action 'power_cycle'
	option redial_attempts '0'
	option gpio_power_name '5g1'
config modem 'modem2'
	option section '2_1'
	option enabled '1'
	option action 'power_cycle'
	option redial_attempts '0'
	option gpio_power_name '5g2'
