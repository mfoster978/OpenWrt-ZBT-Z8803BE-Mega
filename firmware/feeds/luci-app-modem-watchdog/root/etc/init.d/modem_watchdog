#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
PROG=/usr/sbin/modem-watchdog
start_service() {
	# Always collect read-only health for LEDs; UCI flags gate recovery only.
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 10 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger modem_watchdog
}
