#!/bin/sh
# Health collection remains active for LEDs when recovery is switched off.
. /usr/lib/zbt/modem-recovery.sh
. /usr/lib/zbt/mwan-runtime.sh
umask 077
mkdir -p "$ZBT_RECOVERY_DIR"
exec 7>"$ZBT_RECOVERY_DIR/worker.lock"
flock -n 7 || exit 0
trap 'exit 0' INT TERM
while :; do
	interval=$(zbt_recovery_uint "$(zbt_recovery_get global.interval_seconds)" 20 10 60)
	for section in 4_1 2_1; do
		zbt_recovery_resume "$section"
		zbt_health_probe "$section" || true
		zbt_health_save "$section"
		# USB recovery waits must not stall health/LED checks on the peer.
		(
			exec 7>&-
			exec 8>"$ZBT_RECOVERY_DIR/$section.check.lock"
			flock -n 8 || exit 0
			key=modem1; [ "$section" != 2_1 ] || key=modem2
			zbt_recovery_check "$section" "$key"
		) &
	done
	/usr/sbin/zbt-modem-led-poller once >/dev/null 2>&1
	# Direct modem tests can pass while the installed failover policy rejects
	# all clients. Let MWAN3 reconcile its own runtime state before session cleanup.
	/usr/sbin/zbt-mwan-apply
	# A connected hotplug can precede the tracker's first TIME publication.
	# Retry verified failback after that race, for Ethernet and Wi-Fi alike.
	/usr/sbin/zbt-mwan-failback "$(zbt_mwan_winner)"
	/usr/sbin/zbt-mwan-failback "$(zbt_mwan_winner 6)"
	sleep "$interval"
done
